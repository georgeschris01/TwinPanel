<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TwinPanel.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground">#EEF1F5</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBorder">#DDE2EA</SolidColorBrush>
          <SolidColorBrush x:Key="SubtleText">#6B7280</SolidColorBrush>
          <SolidColorBrush x:Key="ChipBackground">#E6EAF0</SolidColorBrush>
          <SolidColorBrush x:Key="HoverFill">#14000000</SolidColorBrush>
          <SolidColorBrush x:Key="ArrivedFill">#3329A35A</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground">#16181D</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#1E2128</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBorder">#2C313A</SolidColorBrush>
          <SolidColorBrush x:Key="SubtleText">#9AA3AF</SolidColorBrush>
          <SolidColorBrush x:Key="ChipBackground">#2A2F38</SolidColorBrush>
          <SolidColorBrush x:Key="HoverFill">#1AFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ArrivedFill">#4D3FB96E</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Icônes de la barre d'outils (dessinées pour le projet, grille 24x24) -->
      <StreamGeometry x:Key="IconBack">M20,11 L7.8,11 L13.4,5.4 L12,4 L4,12 L12,20 L13.4,18.6 L7.8,13 L20,13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconForward">M4,11 L16.2,11 L10.6,5.4 L12,4 L20,12 L12,20 L10.6,18.6 L16.2,13 L4,13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconUp">M11,20 L11,7.8 L5.4,13.4 L4,12 L12,4 L20,12 L18.6,13.4 L13,7.8 L13,20 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M17.65,6.35 A8,8 0 1 0 19.73,14 L17.65,14 A6,6 0 1 1 16.24,7.76 L13,11 L20,11 L20,4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M11,5 L13,5 L13,11 L19,11 L19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 Z</StreamGeometry>
      <x:Double x:Key="PanelFontSize">14</x:Double>
      <!-- Police et taille de TOUTES les fenêtres (Options → Affichage ; ressources mises à jour par la fenêtre principale). -->
      <x:Double x:Key="AppFontSize">14</x:Double>
      <!-- Serveur (deux baies) : connexions distantes -->
      <StreamGeometry x:Key="IconServer">F0 M4,3 L20,3 A1,1 0 0 1 21,4 L21,10 A1,1 0 0 1 20,11 L4,11 A1,1 0 0 1 3,10 L3,4 A1,1 0 0 1 4,3 Z M5,5 L5,9 L19,9 L19,5 Z M6,6 L8,6 L8,8 L6,8 Z M4,13 L20,13 A1,1 0 0 1 21,14 L21,20 A1,1 0 0 1 20,21 L4,21 A1,1 0 0 1 3,20 L3,14 A1,1 0 0 1 4,13 Z M5,15 L5,19 L19,19 L19,15 Z M6,16 L8,16 L8,18 L6,18 Z</StreamGeometry>
      <!-- Fusée stylisée : menu Démarrer personnel -->
      <StreamGeometry x:Key="IconStart">F0 M14,2 C18,2 22,6 22,10 L17,15 L17,19 L14,22 L13,17 L7,11 L2,10 L5,7 L9,7 Z M15.5,6.5 A2,2 0 1 0 15.5,10.5 A2,2 0 1 0 15.5,6.5 Z M5,15 L9,19 L4,21 L3,20 Z</StreamGeometry>
      <!-- Terminal : fenêtre avec invite « > _ » -->
      <StreamGeometry x:Key="IconTerminal">F0 M3,4 L21,4 A1,1 0 0 1 22,5 L22,19 A1,1 0 0 1 21,20 L3,20 A1,1 0 0 1 2,19 L2,5 A1,1 0 0 1 3,4 Z M4,6 L4,18 L20,18 L20,6 Z M6,8.5 L7.4,7.1 L11.3,11 L7.4,14.9 L6,13.5 L8.5,11 Z M12,13 L18,13 L18,15 L12,15 Z</StreamGeometry>
      <!-- Programme : fenêtre d'application -->
      <StreamGeometry x:Key="IconProgram">F0 M4,3 L20,3 A1,1 0 0 1 21,4 L21,20 A1,1 0 0 1 20,21 L4,21 A1,1 0 0 1 3,20 L3,4 A1,1 0 0 1 4,3 Z M5,8 L5,19 L19,19 L19,8 Z M5,5 L5,6.5 L19,6.5 L19,5 Z</StreamGeometry>
      <!-- Lecteurs : disque dur, clé USB, réseau, CD -->
      <StreamGeometry x:Key="IconDrive">F0 M4,6 L20,6 A2,2 0 0 1 22,8 L22,16 A2,2 0 0 1 20,18 L4,18 A2,2 0 0 1 2,16 L2,8 A2,2 0 0 1 4,6 Z M4,8 L4,16 L20,16 L20,8 Z M16,11 L18,11 L18,13 L16,13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconUsb">F0 M8,2 L16,2 L16,9 L18,9 L18,20 A2,2 0 0 1 16,22 L8,22 A2,2 0 0 1 6,20 L6,9 L8,9 Z M10,4 L10,7 L11.5,7 L11.5,4 Z M12.5,4 L12.5,7 L14,7 L14,4 Z M8,11 L8,20 L16,20 L16,11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconNetwork">F0 M4,3 L20,3 A1,1 0 0 1 21,4 L21,13 A1,1 0 0 1 20,14 L13,14 L13,17 L19,17 L19,19 L13,19 L13,21 L11,21 L11,19 L5,19 L5,17 L11,17 L11,14 L4,14 A1,1 0 0 1 3,13 L3,4 A1,1 0 0 1 4,3 Z M5,5 L5,12 L19,12 L19,5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCd">F0 M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 Z M12,4 A8,8 0 1 0 12,20 A8,8 0 1 0 12,4 Z M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStar">M12,2 L15.1,8.6 L22,9.3 L16.8,14 L18.2,21 L12,17.3 L5.8,21 L7.2,14 L2,9.3 L8.9,8.6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconEye">F0 M12,5 C7,5 2.7,8.1 1,12 C2.7,15.9 7,19 12,19 C17,19 21.3,15.9 23,12 C21.3,8.1 17,5 12,5 Z M12,16.5 A4.5,4.5 0 1 1 12,7.5 A4.5,4.5 0 1 1 12,16.5 Z M12,9.5 A2.5,2.5 0 1 0 12,14.5 A2.5,2.5 0 1 0 12,9.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTheme">F0 M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,4 L12,20 A8,8 0 0 1 12,4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSwap">M7,7 L17,7 L17,4 L21,8 L17,12 L17,9 L7,9 Z M17,17 L7,17 L7,20 L3,16 L7,12 L7,15 L17,15 Z</StreamGeometry>
      <StreamGeometry x:Key="IconHome">M12,3 L2,12 L5,12 L5,20 L10,20 L10,14 L14,14 L14,20 L19,20 L19,12 L22,12 Z</StreamGeometry>
      <StreamGeometry x:Key="IconEdit">M3,17.25 L3,21 L6.75,21 L17.8,9.94 L14.06,6.19 Z M20.7,7.04 A1,1 0 0 0 20.7,5.63 L18.37,3.29 A1,1 0 0 0 16.96,3.29 L15.13,5.12 L18.88,8.87 Z</StreamGeometry>
      <StreamGeometry x:Key="IconLock">M7,10 L7,7.5 C7,4.5 9.2,2.5 12,2.5 C14.8,2.5 17,4.5 17,7.5 L17,10 L18,10 C19.1,10 20,10.9 20,12 L20,19 C20,20.1 19.1,21 18,21 L6,21 C4.9,21 4,20.1 4,19 L4,12 C4,10.9 4.9,10 6,10 Z M9,10 L15,10 L15,7.5 C15,5.7 13.7,4.5 12,4.5 C10.3,4.5 9,5.7 9,7.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSearch">F0 M9.5,3 A6.5,6.5 0 0 1 14.71,13.29 L20.71,19.29 L19.29,20.71 L13.29,14.71 A6.5,6.5 0 1 1 9.5,3 Z M9.5,5 A4.5,4.5 0 1 0 9.5,14 A4.5,4.5 0 1 0 9.5,5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconMenu">M3,6 L21,6 L21,8 L3,8 Z M3,11 L21,11 L21,13 L3,13 Z M3,16 L21,16 L21,18 L3,18 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M3,6 C3,4.9 3.9,4 5,4 L9.6,4 L11.6,6 L19,6 C20.1,6 21,6.9 21,8 L21,18 C21,19.1 20.1,20 19,20 L5,20 C3.9,20 3,19.1 3,18 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

    <!-- Police et taille de toutes les fenêtres (AppFontFamily est créée au démarrage par la fenêtre principale) -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="/Assets/twinpanel.ico" />
      <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    </Style>

    <!-- Boutons-icônes plats de la barre d'outils -->
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="Button.icon PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Button.small PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="ToggleButton.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="ToggleButton.icon PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>

    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="36" />
    </Style>

    <Style Selector="Button.chip">
      <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Texte des fichiers marqués (comme le rouge de TC, en plus doux) -->
    <!-- Nom coloré (Options → Couleurs) : seulement sur les lignes qui ont une couleur ; les autres gardent celle du thème.
         Placé AVANT « marked » : un fichier marqué reste rouge. -->
    <Style Selector="TextBlock.colored">
      <Setter Property="Foreground" Value="{Binding NameColor}" />
    </Style>
    <!-- Dossier visé pendant un glisser de fichiers (colonne Nom) -->
    <Style Selector="Border.dropFrame">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- Éléments qui viennent d'arriver (copie, déplacement) : mis en valeur quelques secondes. -->
    <Style Selector="Border.dropFrame.arrived">
      <Setter Property="Background" Value="{DynamicResource ArrivedFill}" />
    </Style>
    <Style Selector="Border.dropFrame.dropTarget">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>
    <Style Selector="TextBlock.marked">
      <Setter Property="Foreground" Value="#E5534B" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Barre des touches de fonction -->
    <Style Selector="Button.fkey">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="6,6" />
    </Style>
    <Style Selector="Border.keycap">
      <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.keycap TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.subtle">
      <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
